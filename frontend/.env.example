# Base URL of the backend API. No trailing slash.
#
# .env             -> local development (this value)
# .env.production  -> used automatically by `vite build` / deployments
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID. Must match backend GOOGLE_CLIENT_ID.
# Keep GOOGLE_CLIENT_SECRET only in backend/.env; never expose it here.
VITE_GOOGLE_CLIENT_ID=
