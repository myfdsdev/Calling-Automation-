# ---- Core ----
PORT=5000
NODE_ENV=development
# Allowed frontend origin(s). Comma-separate to allow several
# (e.g. a deployed frontend plus local dev):
#   CLIENT_URL=https://your-app.onrender.com,http://localhost:5173
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/leadcall_ai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Gemini (script generation, lead scoring, call analysis) ----
# Leave empty to use the built-in deterministic fallback (demo mode).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Vapi (AI voice calling) ----
VAPI_PRIVATE_KEY=
# Optional: if you already imported a number in the Vapi dashboard, paste its id.
# Otherwise leave blank and the app imports your Twilio number below automatically.
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# Public HTTPS URL of THIS backend so Vapi can deliver call events.
# Local dev: run `ngrok http 5000` and paste the https URL here (no trailing slash).
VAPI_SERVER_URL=

# ---- Twilio ----
# NOT configured here. Each user connects their OWN Twilio account (Account SID,
# Auth Token, phone number) from API Settings in the app. Their number is then
# imported into the platform Vapi account above.
#
# This key encrypts those stored auth tokens at rest (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_SECRET=

# ---- Demo mode ----
# When true, calls are SIMULATED locally with fabricated transcripts (no real dialing).
# Keep this false for real calling — with it false, starting an automation without a
# configured provider fails loudly instead of faking calls.
DEMO_MODE=false

# ---- Lead provider: SerpAPI (Google Maps engine) ----
# Get a key at https://serpapi.com/manage-api-key
# Leave empty to generate synthetic local leads (demo mode).
SERPAPI_API_KEY=
SERPAPI_HL=en                 # interface language
SERPAPI_GL=us                 # country for results

# ---- Recording storage (optional) ----
CLOUDINARY_URL=

# ---- New-user quotas ----
DEFAULT_LEAD_CREDITS=500
DEFAULT_CALLING_MINUTES=120
